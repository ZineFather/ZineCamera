<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootCameraLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/zine_black"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="ZINE CAMERA"
            android:textColor="@color/zine_text"
            android:textSize="15sp"
            android:fontFamily="sans"
            android:letterSpacing="0.08" />

        <ImageView
            android:id="@+id/flashButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:background="@drawable/bg_glass_pill"
            android:src="@drawable/ic_flash_camera"
            android:scaleType="centerInside"
            android:tint="@color/zine_text"
            android:contentDescription="Flash options" />

        <TextView
            android:id="@+id/timerButton"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/bg_glass_pill"
            android:text="OFF"
            android:textColor="@color/zine_text"
            android:textSize="10sp"
            android:contentDescription="Timer options" />

        <TextView
            android:id="@+id/qualityButton"
            android:layout_width="58dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/bg_glass_pill"
            android:text="3:4"
            android:textColor="@color/zine_text"
            android:textSize="11sp"
            android:contentDescription="Aspect ratio or video quality" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/bg_glass_pill"
            android:text="⚙"
            android:textColor="@color/zine_text"
            android:textSize="19sp"
            android:contentDescription="Camera settings" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="5dp">

        <TextureView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/framingMiniContainer"
            android:layout_width="116dp"
            android:layout_height="132dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_status"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:visibility="invisible">

            <TextureView
                android:id="@+id/framingMiniPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.zinecamera.ZoomFramingMiniMap
                android:id="@+id/framingMiniOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_status"
            android:text="Starting camera"
            android:textColor="@color/zine_text"
            android:textSize="11sp"
            android:maxLines="2" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/zoomValue"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="@color/zine_text"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/zoomSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/zine_accent"
            android:thumbTint="@color/zine_text" />

        <TextView
            android:id="@+id/zoomMode"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="100x"
            android:textColor="@color/zine_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zoomPresetContainer"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView android:id="@+id/zoomPreset1" style="@style/ModePill" android:text="1x" />
        <TextView android:id="@+id/zoomPreset2" style="@style/ModePill" android:text="2x" />
        <TextView android:id="@+id/zoomPreset4" style="@style/ModePill" android:text="4x" />
        <TextView android:id="@+id/zoomPreset10" style="@style/ModePill" android:text="10x" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:id="@+id/modeScrollContainer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/modeContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/modePhoto" style="@style/ModeSelectorItem" android:text="PHOTO" />
                <TextView android:id="@+id/modeVideo" style="@style/ModeSelectorItem" android:text="VIDEO" />
                <TextView android:id="@+id/modePortrait" style="@style/ModeSelectorItem" android:text="PORTRAIT" />
                <TextView android:id="@+id/modeNight" style="@style/ModeSelectorItem" android:text="NIGHT" />
                <TextView android:id="@+id/modePro" style="@style/ModeSelectorItem" android:text="PRO" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/galleryButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Open gallery"
                android:tint="@color/zine_text"
                android:background="@drawable/bg_glass_pill"
                android:padding="14dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/shutterButton"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter" />

                <TextView
                    android:id="@+id/recordIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="5dp"
                    android:text="CAPTURE"
                    android:textColor="@color/zine_muted"
                    android:textSize="9sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/switchButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:background="@drawable/bg_glass_pill"
                android:text="↻"
                android:textColor="@color/zine_text"
                android:textSize="25sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
