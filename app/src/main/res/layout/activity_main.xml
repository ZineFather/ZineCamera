<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/zine_black"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ZINE CAMERA"
            android:textColor="@color/zine_text"
            android:textSize="16sp"
            android:letterSpacing="0.12" />
        <TextView
            android:id="@+id/qualityButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_glass_pill"
            android:text="3:4"
            android:textColor="@color/zine_text"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/bg_glass_pill"
            android:text="⚙"
            android:textColor="@color/zine_text"
            android:textSize="19sp"
            android:contentDescription="Camera settings" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp">
        <TextureView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_status"
            android:text="Starting camera"
            android:textColor="@color/zine_text"
            android:textSize="11sp"
            android:maxLines="2" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="vertical"
            android:layout_marginTop="70dp">
            <ImageView
                android:id="@+id/flashButton"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:background="@drawable/bg_glass_pill"
                android:src="@drawable/ic_flash_camera"
                android:contentDescription="Toggle flash"
                android:tint="@color/zine_text" />
            <TextView
                android:id="@+id/timerButton"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:background="@drawable/bg_glass_pill"
                android:text="3s"
                android:textColor="@color/zine_text"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/zoomValue"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="@color/zine_text"
            android:textSize="14sp" />
        <SeekBar
            android:id="@+id/zoomSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/zine_accent"
            android:thumbTint="@color/zine_text" />
        <TextView
            android:id="@+id/zoomMode"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="100x"
            android:textColor="@color/zine_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center"
        android:orientation="horizontal">
        <TextView android:id="@+id/modePhoto" style="@style/ModePill" android:text="PHOTO" />
        <TextView android:id="@+id/modeVideo" style="@style/ModePill" android:text="VIDEO" />
        <TextView android:id="@+id/modePortrait" style="@style/ModePill" android:text="PORTRAIT" />
        <TextView android:id="@+id/modeNight" style="@style/ModePill" android:text="NIGHT" />
        <TextView android:id="@+id/modePro" style="@style/ModePill" android:text="PRO" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/galleryButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Open gallery"
            android:tint="@color/zine_text"
            android:background="@drawable/bg_glass_pill"
            android:padding="14dp" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foregroundGravity="center">
            <View
                android:id="@+id/shutterButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter" />
            <TextView
                android:id="@+id/recordIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:text="CAPTURE"
                android:textColor="@color/zine_muted"
                android:textSize="9sp" />
        </FrameLayout>
        <TextView
            android:id="@+id/switchButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:background="@drawable/bg_glass_pill"
            android:text="↻"
            android:textColor="@color/zine_text"
            android:textSize="25sp" />
    </LinearLayout>
</LinearLayout>
